pipeline {
    agent { label 'sonarqube-agent' }

    parameters {
        booleanParam(name: 'RUN_MAIN_SCAN', defaultValue: false, description: 'Run one-time main scan')
    }

    environment {
        SONAR_QUBE_KEY = credentials('sonar-token')
    }

    stages {
        stage('SCM') {
            steps { checkout scm }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarScanner'
                    withSonarQubeEnv() {
                        if (params.RUN_MAIN_SCAN && env.BRANCH_NAME == 'main') {
                            sh """
                                ${scannerHome}/bin/sonar-scanner \
                                -Dsonar.projectKey=core_infrastructrue \
                                -Dsonar.projectName=core_infrastructrue \
                                -Dsonar.branch.name=main
                            """
                        } else if (env.CHANGE_ID) {
                            sh """
                                ${scannerHome}/bin/sonar-scanner \
                                -Dsonar.projectKey=core_infrastructrue \
                                -Dsonar.projectName=core_infrastructrue \
                                -Dsonar.pullrequest.key=${env.CHANGE_ID} \
                                -Dsonar.pullrequest.branch=${env.CHANGE_BRANCH} \
                                -Dsonar.pullrequest.base=${env.CHANGE_TARGET}
                            """
                        }
                    }
                }
            }
        }
    }
}
